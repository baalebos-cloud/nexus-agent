# Copy this file to .env and fill in real values.
# All fields map 1:1 to src/api/config.py:Settings — nothing else in the
# codebase reads os.environ directly.

# --- Sandboxed Execution Engine ---
E2B_API_KEY=

# --- Infra (defaults match docker-compose.yml service names/ports) ---
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Sandbox policy (optional overrides; sane defaults exist in Settings) ---
SANDBOX_DEFAULT_TIMEOUT_SECONDS=30
SANDBOX_MAX_TIMEOUT_SECONDS=120
SANDBOX_MAX_OUTPUT_CHARS=8000
SANDBOX_ALLOW_SHELL=true
SANDBOX_ALLOW_CLONE_REPO=true
SANDBOX_DEFAULT_TTL_SECONDS=600
SANDBOX_REAPER_INTERVAL_SECONDS=60

# --- Fine-tuning: live-usage capture (src/finetune/capture.py) ---
# OFF by default — capturing conversation transcripts has real privacy
# implications. Set to true only if you intend to use captured
# conversations as QLoRA training data (see src/finetune/README notes).
# Conversations that invoked an OSINT tool are NEVER auto-captured as
# valid training data regardless of this setting — they're quarantined
# to TRAINING_CAPTURE_PENDING_REVIEW_PATH for human review instead.
CAPTURE_TRAINING_DATA=false
TRAINING_CAPTURE_PATH=data/finetune/captured.jsonl
TRAINING_CAPTURE_PENDING_REVIEW_PATH=data/finetune/pending_osint_review.jsonl

# --- OSINT ---
# Path to the YuNet ONNX model — see src/osint/face_detector_loader.py for
# download instructions. Not bundled in this repo.
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx

# --- Voice Stack (LiveKit pipeline) ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Streaming LLM (vLLM self-hosted or Groq, per PROJECT_CONTEXT.md) ---
# Required to unblock src/voice/worker.py and to wire app.state.chat_llm
# in src/api/server.py for the /chat endpoint. Works with any
# OpenAI-compatible endpoint (Groq, self-hosted vLLM, etc.).
#
# IMPORTANT: the model you choose MUST support tool/function calling, since
# the orchestrator binds sandbox/OSINT tools to it. Groq model names change
# over time — verify what your key can actually access before picking one:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $STREAMING_LLM_API_KEY" | python3 -m json.tool
# Look for "supported_features": [..., "tools", ...] in the response.
#
# Groq quickstart: https://console.groq.com -> API Keys
#   STREAMING_LLM_BASE_URL=https://api.groq.com/openai/v1
#   STREAMING_LLM_API_KEY=<your groq key>
#   STREAMING_LLM_MODEL=openai/gpt-oss-120b   (or another tools-capable model)
#
# Self-hosted vLLM: run `vllm serve <your-model>` on your own infra, then
#   STREAMING_LLM_BASE_URL=http://<your-host>:8000/v1
#   STREAMING_LLM_API_KEY=   (leave blank if vLLM has no auth in front of it)
#   STREAMING_LLM_MODEL=<the --served-model-name you used>
STREAMING_LLM_BASE_URL=
STREAMING_LLM_API_KEY=
STREAMING_LLM_MODEL=openai/gpt-oss-120b
